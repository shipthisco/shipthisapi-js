{
  "name": "shipthisapi-js",
  "version": "2.0.6",
  "description": "Wrapper for shipthis api",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "devDependencies": {
    "@types/jest": "~29.5",
    "@types/node": "~22.15",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "~10.1",
    "eslint-plugin-jest": "~28.11",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "rimraf": "~6.0",
    "ts-jest": "^29.3.4",
    "tsutils": "~3.21",
    "typescript": "^5.8.3"
  },
  "scripts": {
    "start": "node dist/shipthisapi-js/main.js",
    "clean": "rimraf coverage build tmp",
    "prebuild": "node ./scripts/pre-build && npm run lint",
    "build": "tsc -p tsconfig.prod.json",
    "postbuild": "node ./scripts/pre-publish",
    "build:watch": "tsc -w -p tsconfig.prod.json",
    "lint": "eslint ./src --ext .ts",
    "test": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "author": "Mayur Rawte",
  "license": "Apache-2.0",
  "dependencies": {
    "axios": "^1.9.0",
    "tslib": "~2.8.1"
  },
  "volta": {
    "node": "16.13.0"
  }
}
