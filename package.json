  "description": "Wrapper for shipthis api",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "devDependencies": {
    "@types/jest": "~30.0",
    "@types/node": "~26.4",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "~10.1",
    "eslint-plugin-jest": "^29.15.0",
    "jest": "^30.5.0",
    "prettier": "^3.5.3",
    "rimraf": "~6.1",
    "ts-jest": "^29.3.4",
    "tsutils": "~3.21",
    "typescript": "^7.0.2"
  },
  "scripts": {
